  "voiceover": [
    { "start": 1, "end": 7, "voice": "A", "text": "Twenty eighty-seven. Two billion people live underground. This is the Hollow." },
    { "start": 7, "end": 12, "voice": "A", "text": "Mara lives in the Deep, the lowest level. Tonight the lights are failing." },
    { "start": 12, "end": 18, "voice": "A", "text": "The Directorate controls the power, the network and the truth. Mara has Strata." },

    { "start": 18, "end": 25, "voice": "B", "text": "Strata runs five hundred simulations of the grid. In ninety-six percent, the Deep goes dark within two minutes." },
    { "start": 25, "end": 30, "voice": "B", "text": "It proposes a fix inside limits the residents set. Mara approves." },
    { "start": 30, "end": 37, "voice": "B", "text": "The Directorate's plan cuts the bottom two levels to zero: nineteen thousand four hundred people lose water and air." },
    { "start": 37, "end": 41, "voice": "A", "text": "Apply it, and the Deep goes black." },
    { "start": 41, "end": 46, "voice": "B", "text": "Strata's split gives every level its survival minimum first. All three limits pass." },
    { "start": 46, "end": 52, "voice": "A", "text": "One tap in the app, and the Deep's lights hold. The lift comes back on." },

    { "start": 52, "end": 55, "voice": "A", "text": "Power runs everything else, too." },
    { "start": 55, "end": 59, "voice": "B", "text": "Nobody's cut off now, but a pipe is leaking." },
    { "start": 59, "end": 65, "voice": "B", "text": "Isolate the leak: nine days of water becomes twelve and a half. The sign turns green." },
    { "start": 65, "end": 70, "voice": "B", "text": "Grow lamps move to the night. Food lasts a hundred thirty-two days." },
    { "start": 70, "end": 76, "voice": "B", "text": "Medicine goes where it's needed. The Deep's inhalers last almost a week." },
    { "start": 76, "end": 82, "voice": "B", "text": "Cooling never stops. Under the Directorate's plan, the Deep would overheat in three hours." },
    { "start": 82, "end": 90, "voice": "B", "text": "And the worst lungs, down in the Deep, get the first sun-lamp sessions tonight." },

    { "start": 90, "end": 96, "voice": "A", "text": "Then the Directorate cuts the network. Strata doesn't need it." },
    { "start": 96, "end": 102, "voice": "B", "text": "Phones pass the warning hand to hand. A hundred thirteen phones, no towers." },
    { "start": 102, "end": 110, "voice": "A", "text": "Ava, Mara's daughter, is two levels up. Her signed reply comes back down: she's safe." },
    { "start": 110, "end": 117, "voice": "B", "text": "And anyone can ask Strata a question. Every answer is worked out live from the same models, even offline." },
    { "start": 117, "end": 124, "voice": "B", "text": "Signed memory cards are read only when Mara allows them. Anything unsigned is blocked, and the live relay stays off.", "added": true },

    { "start": 124, "end": 133, "voice": "A", "text": "The Directorate says the surface kills in minutes. Nobody below has ever checked." },
    { "start": 133, "end": 139, "voice": "B", "text": "A drone maps the radiation hotspots." },
    { "start": 139, "end": 144, "voice": "B", "text": "The probe reads normal background. Five minutes unprotected, six hours in a sealed suit." },
    { "start": 144, "end": 148, "voice": "B", "text": "Strata picks twelve volunteers: best lungs, every skill covered." },
    { "start": 148, "end": 153, "voice": "A", "text": "Mara plants the probe at the safest spot." },
    { "start": 153, "end": 160, "voice": "A", "text": "She signs the reading and sends it below. Hours, not minutes. The truth is out." },

    { "start": 160, "end": 165, "voice": "B", "text": "One lift, forty-eight thousand people. Strata plans the way up in four waves." },
    { "start": 165, "end": 171, "voice": "B", "text": "The Deep is the most crowded and the sickest, so it goes first." },
    { "start": 171, "end": 177, "voice": "B", "text": "Staggered shifts cut the crowd in the tunnels from fourteen thousand to three thousand." },
    { "start": 177, "end": 182, "voice": "B", "text": "Everyone is up by day sixty-four." },

    { "start": 182, "end": 189, "voice": "C", "text": "Fifteen problems. One app, wired into the world it runs." },
    { "start": 189, "end": 194, "voice": "ABC", "text": "Strata. The truth, and the way up." }
  ]
}
